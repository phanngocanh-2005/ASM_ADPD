@model AuthApp.Models.ViewModels.StudentGradesViewModel

@{
    ViewData["Title"] = "My Grades";
}

<!-- GRADES PAGE - DO NOT REMOVE THIS COMMENT -->
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="fas fa-chart-line"></i> My Grades
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.GradesByCourse != null && Model.GradesByCourse.Any())
    {
        @foreach (var courseGroup in Model.GradesByCourse)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-book"></i> @courseGroup.Course.CourseCode - @courseGroup.Course.CourseName
                        </h5>
                        <div>
                            <span class="badge bg-light text-dark">Credits: @courseGroup.Course.Credits</span>
                            @if (courseGroup.Course.Semester.HasValue)
                            {
                                <span class="badge bg-light text-dark">Semester: @courseGroup.Course.Semester</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Course Summary -->
                    <div class="row mb-3 p-3 bg-light rounded">
                        <div class="col-md-3 text-center">
                            <h4 class="text-primary mb-0">@courseGroup.AverageScore.ToString("0.00")</h4>
                            <small class="text-muted">Average Score</small>
                        </div>
                        <div class="col-md-3 text-center">
                            <h4 class="text-info mb-0">@courseGroup.TotalRecords</h4>
                            <small class="text-muted">Total Assignments</small>
                        </div>
                        <div class="col-md-3 text-center">
                            <h4 class="text-success mb-0">@courseGroup.Records.Count(r => (r.Score / r.MaxScore) * 100 >= 50)</h4>
                            <small class="text-muted">Passed</small>
                        </div>
                        <div class="col-md-3 text-center">
                            <h4 class="text-danger mb-0">@courseGroup.Records.Count(r => (r.Score / r.MaxScore) * 100 < 50)</h4>
                            <small class="text-muted">Failed</small>
                        </div>
                    </div>

                    <!-- Grades Table -->
                    <div class="table-responsive">
                        <table class="table table-hover table-bordered">
                            <thead class="table-light">
                                <tr>
                                    <th>Assignment Type</th>
                                    <th>Score</th>
                                    <th>Max Score</th>
                                    <th>Percentage</th>
                                    <th>Weight (%)</th>
                                    <th>Graded Date</th>
                                    <th>Graded By</th>
                                    <th>Notes</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var record in courseGroup.Records)
                                {
                                    var percentage = (record.Score / record.MaxScore) * 100;
                                    <tr class="@(percentage >= 70 ? "table-success" : percentage >= 50 ? "table-warning" : "table-danger")">
                                        <td>
                                            <span class="badge bg-secondary">@record.AssignmentType</span>
                                        </td>
                                        <td>
                                            <strong class="@(percentage >= 70 ? "text-success" : percentage >= 50 ? "text-warning" : "text-danger")">
                                                @record.Score.ToString("0.00")
                                            </strong>
                                        </td>
                                        <td>@record.MaxScore.ToString("0.00")</td>
                                        <td>
                                            <span class="badge @(percentage >= 70 ? "bg-success" : percentage >= 50 ? "bg-warning" : "bg-danger")">
                                                @percentage.ToString("0.00")%
                                            </span>
                                        </td>
                                        <td>@(record.Weight?.ToString("0.00") ?? "-")</td>
                                        <td>@(record.GradedDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td>
                                            @if (record.Teacher != null)
                                            {
                                                <small><i class="fas fa-user-tie"></i> @record.Teacher.FullName</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(record.Notes))
                                            {
                                                <small><i class="fas fa-comment"></i> @record.Notes</small>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No grades available yet. Grades will appear here once your teachers upload them.
        </div>
    }

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

