@{
    ViewData["Title"] = "Student Dashboard";
}

<style>
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }
    
    .card {
        border-radius: 10px;
    }
    
    .card-body {
        min-height: 280px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
</style>

<div class="container mt-5">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <h1 class="text-center text-primary mb-4">
                <i class="fas fa-graduation-cap"></i> Student Dashboard
            </h1>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6 col-lg-6 mb-4">
            <div class="card shadow-sm h-100 border-0" style="transition: transform 0.2s, box-shadow 0.2s;">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-user-graduate fa-4x text-primary"></i>
                    </div>
                    <h4 class="card-title mb-3">My Profile</h4>
                    <p class="card-text text-muted mb-4">View and manage your personal information, academic program, and account details.</p>
                    <a asp-action="Profile" class="btn btn-primary btn-lg">
                        <i class="fas fa-eye me-2"></i> View Profile
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-6 mb-4">
            <div class="card shadow-sm h-100 border-0" style="transition: transform 0.2s, box-shadow 0.2s;">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-edit fa-4x text-success"></i>
                    </div>
                    <h4 class="card-title mb-3">Edit Profile</h4>
                    <p class="card-text text-muted mb-4">Update your personal information, contact details, and preferences.</p>
                    <a asp-action="EditProfile" class="btn btn-success btn-lg">
                        <i class="fas fa-edit me-2"></i> Edit Profile
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-6 col-lg-6 mb-4">
            <div class="card shadow-sm h-100 border-0" style="transition: transform 0.2s, box-shadow 0.2s;">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-calendar-alt fa-4x text-warning"></i>
                    </div>
                    <h4 class="card-title mb-3">My Schedule</h4>
                    <p class="card-text text-muted mb-4">View your class timetable and schedule updated by administrators.</p>
                    <a asp-action="Schedule" class="btn btn-warning btn-lg">
                        <i class="fas fa-calendar-alt me-2"></i> View Schedule
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-6 mb-4">
            <div class="card shadow-sm h-100 border-0" style="transition: transform 0.2s, box-shadow 0.2s;">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="fas fa-chart-line fa-4x text-info"></i>
                    </div>
                    <h4 class="card-title mb-3">My Grades</h4>
                    <p class="card-text text-muted mb-4">View your grades and academic records uploaded by teachers.</p>
                    <a asp-action="Grades" class="btn btn-info btn-lg text-white">
                        <i class="fas fa-chart-line me-2"></i> View Grades
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
