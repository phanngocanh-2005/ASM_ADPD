@{
    ViewData["Title"] = "Student Dashboard";
}

<div class="container mt-5">
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <h1 class="text-center text-primary mb-4">
                <i class="fas fa-graduation-cap"></i> Student Dashboard
            </h1>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-user-graduate fa-3x text-primary mb-3"></i>
                    <h5 class="card-title">My Profile</h5>
                    <p class="card-text">View and manage your personal information, courses, and grades.</p>
                    <a asp-action="Profile" class="btn btn-primary">
                        <i class="fas fa-eye"></i> View Profile
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-edit fa-3x text-success mb-3"></i>
                    <h5 class="card-title">Edit Profile</h5>
                    <p class="card-text">Update your personal information and contact details.</p>
                    <a asp-action="EditProfile" class="btn btn-success">
                        <i class="fas fa-edit"></i> Edit Profile
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-book fa-3x text-info mb-3"></i>
                    <h5 class="card-title">My Courses</h5>
                    <p class="card-text">View all your enrolled courses and academic progress.</p>
                    <a asp-action="Courses" class="btn btn-info">
                        <i class="fas fa-book"></i> View Courses
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
