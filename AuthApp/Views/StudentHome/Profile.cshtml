@model AuthApp.Models.Student

@{
    ViewData["Title"] = "My Profile";
}

<!-- PROFILE PAGE - DO NOT REMOVE THIS COMMENT -->
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="fas fa-user-graduate"></i> My Profile
        </h2>
        <div>
            <a asp-action="EditProfile" class="btn btn-primary me-2">
                <i class="fas fa-edit"></i> Edit Profile
            </a>
            <a asp-action="DeleteProfile" class="btn btn-danger">
                <i class="fas fa-trash"></i> Delete Profile
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Personal Information Card -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-user"></i> Personal Information</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th width="40%">Student ID:</th>
                            <td><strong>@Model.StudentCode</strong></td>
                        </tr>
                        <tr>
                            <th>Full Name:</th>
                            <td>@Model.FullName</td>
                        </tr>
                        <tr>
                            <th>Date of Birth:</th>
                            <td>@Model.DateOfBirth.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <th>Gender:</th>
                            <td>@(Model.Gender ?? "-")</td>
                        </tr>
                        <tr>
                            <th>Phone Number:</th>
                            <td>@(Model.PhoneNumber ?? "-")</td>
                        </tr>
                        <tr>
                            <th>Address:</th>
                            <td>@(Model.Address ?? "-")</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>

        <!-- Account & Academic Information Card -->
        <div class="col-md-6 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-graduation-cap"></i> Account & Academic Information</h5>
                </div>
                <div class="card-body">
                    <table class="table table-borderless">
                        <tr>
                            <th width="40%">Username:</th>
                            <td>
                                @if (Model.Account != null)
                                {
                                    <span class="badge bg-success">@Model.Account.Username</span>
                                }
                                else
                                {
                                    <span class="text-muted">No account linked</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Email:</th>
                            <td>
                                @if (Model.Account != null)
                                {
                                    @Model.Account.Email
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Academic Program (Class):</th>
                            <td>
                                <strong>@Model.AcademicProgram?.ProgramName</strong>
                                @if (!string.IsNullOrEmpty(Model.AcademicProgram?.ProgramCode))
                                {
                                    <br />
                                    <small class="text-muted">Code: @Model.AcademicProgram.ProgramCode</small>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th>Enrollment Date:</th>
                            <td>@Model.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                        </tr>
                        <tr>
                            <th>Status:</th>
                            <td>
                                <span class="badge @(Model.Status == "Active" ? "bg-success" : Model.Status == "Graduated" ? "bg-primary" : "bg-secondary")">
                                    @Model.Status
                                </span>
                            </td>
                        </tr>
                        <tr>
                            <th>GPA / Score:</th>
                            <td>
                                @if (Model.GPA.HasValue)
                                {
                                    <strong class="text-primary">@Model.GPA.Value.ToString("0.00")</strong>
                                    <span class="text-muted">/ 100</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not available</span>
                                }
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Links Section -->
    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-book fa-3x text-info mb-3"></i>
                    <h5 class="card-title">My Courses</h5>
                    <p class="card-text">View all your enrolled courses</p>
                    <a asp-action="Courses" class="btn btn-info">
                        <i class="fas fa-book"></i> View Courses
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-calendar-alt fa-3x text-warning mb-3"></i>
                    <h5 class="card-title">My Schedule</h5>
                    <p class="card-text">View your class timetable</p>
                    <a asp-action="Schedule" class="btn btn-warning">
                        <i class="fas fa-calendar-alt"></i> View Schedule
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="fas fa-chart-line fa-3x text-success mb-3"></i>
                    <h5 class="card-title">My Grades</h5>
                    <p class="card-text">View your academic records</p>
                    <a asp-action="Grades" class="btn btn-success">
                        <i class="fas fa-chart-line"></i> View Grades
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

