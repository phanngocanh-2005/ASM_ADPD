@model AuthApp.Models.Teacher

@{
    ViewData["Title"] = "Delete teacher";
}

<div class="container mt-4">
    <h2 class="text-danger mb-3">Confirm teacher deletion</h2>
    <div class="alert alert-warning">
        This action cannot be undone. Are you sure you want to remove this teacher?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Teacher ID:</dt>
        <dd class="col-sm-9">@Model.TeacherCode</dd>
        <dt class="col-sm-3">Full name:</dt>
        <dd class="col-sm-9">@Model.FullName</dd>
        <dt class="col-sm-3">Department:</dt>
        <dd class="col-sm-9">@Model.Department</dd>
        <dt class="col-sm-3">Email:</dt>
        <dd class="col-sm-9">@Model.Email ?? @Model.Account?.Email</dd>
        <dt class="col-sm-3">Status:</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-action="DeleteTeacher" method="post">
        <input type="hidden" asp-for="Id" />
        <a asp-action="TeacherProfile" asp-route-id="@Model.Id" class="btn btn-secondary me-2">Back to Profile</a>
        <a asp-action="Teachers" class="btn btn-outline-secondary me-2">Cancel</a>
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
</div>

