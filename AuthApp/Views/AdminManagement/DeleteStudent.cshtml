@model AuthApp.Models.Student

@{
    ViewData["Title"] = "Delete student";
}

<div class="container mt-4">
    <h2 class="text-danger mb-3">Confirm student deletion</h2>
    <div class="alert alert-warning">
        This action cannot be undone. Please confirm before continuing.
    </div>
    <dl class="row">
        <dt class="col-sm-3">Student ID:</dt>
        <dd class="col-sm-9">@Model.StudentCode</dd>
        <dt class="col-sm-3">Full name:</dt>
        <dd class="col-sm-9">@Model.FullName</dd>
        <dt class="col-sm-3">Program:</dt>
        <dd class="col-sm-9">@Model.AcademicProgram?.ProgramName</dd>
        <dt class="col-sm-3">Email:</dt>
        <dd class="col-sm-9">@Model.Account?.Email</dd>
        <dt class="col-sm-3">Status:</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-action="DeleteStudent" method="post">
        <input type="hidden" asp-for="Id" />
        <a asp-action="StudentProfile" asp-route-id="@Model.Id" class="btn btn-secondary me-2">Back to Profile</a>
        <a asp-action="Students" class="btn btn-outline-secondary me-2">Cancel</a>
        <button type="submit" class="btn btn-danger">Delete</button>
    </form>
</div>

