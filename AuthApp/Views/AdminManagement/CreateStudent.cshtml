@model AuthApp.Models.Student

@{
    ViewData["Title"] = "Add student";
    var programOptions = ViewBag.ProgramOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var statusOptions = ViewBag.StudentStatuses as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    var genderOptions = ViewBag.GenderOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<div class="container mt-4">
    <h2 class="text-primary mb-3">Add new student</h2>
    
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-action="CreateStudent" method="post" class="row g-3">
        <div class="col-md-6">
            <label asp-for="StudentCode" class="form-label">Student Code <span class="text-danger">*</span></label>
            <input asp-for="StudentCode" class="form-control" required />
            <span asp-validation-for="StudentCode" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="DateOfBirth" class="form-label"></label>
            <input asp-for="DateOfBirth" type="date" class="form-control" />
            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Gender" class="form-label"></label>
            <select asp-for="Gender" class="form-select" asp-items="genderOptions">
                <option value="">-- Select gender --</option>
            </select>
            <span asp-validation-for="Gender" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
        <div class="col-md-6">
            <label asp-for="AcademicProgramId" class="form-label">Academic Program <span class="text-muted">(optional)</span></label>
            <select asp-for="AcademicProgramId" class="form-select" asp-items="programOptions">
                <option value="">-- Select program (optional) --</option>
            </select>
            <span asp-validation-for="AcademicProgramId" class="text-danger"></span>
            @if (!programOptions.Any())
            {
                <small class="text-warning">No academic programs available. Please create programs first.</small>
            }
        </div>
        <div class="col-md-3">
            <label asp-for="EnrollmentDate" class="form-label"></label>
            <input asp-for="EnrollmentDate" type="date" class="form-control" />
            <span asp-validation-for="EnrollmentDate" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select" asp-items="statusOptions"></select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="GPA" class="form-label">Score (0 - 100)</label>
            <input asp-for="GPA" type="number" min="0" max="100" step="0.1" class="form-control" />
            <span asp-validation-for="GPA" class="text-danger"></span>
        </div>
        <div class="col-12 d-flex justify-content-end">
            <a asp-action="Students" class="btn btn-secondary me-2">Cancel</a>
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}

