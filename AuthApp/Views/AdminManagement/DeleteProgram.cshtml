@model AuthApp.Models.AcademicProgram

@{
    ViewData["Title"] = "Delete academic program";
    var hasRelations = (Model.Courses?.Any() ?? false) || (Model.Students?.Any() ?? false);
}

<div class="container mt-4">
    <h2 class="text-danger mb-3">Delete academic program</h2>

    @if (hasRelations)
    {
        <div class="alert alert-warning">
            This program still has related students or courses. Please reassign them before deleting.
        </div>
    }

    <dl class="row">
        <dt class="col-sm-3">Program code:</dt>
        <dd class="col-sm-9">@Model.ProgramCode</dd>
        <dt class="col-sm-3">Program name:</dt>
        <dd class="col-sm-9">@Model.ProgramName</dd>
        <dt class="col-sm-3">Status:</dt>
        <dd class="col-sm-9">@Model.Status</dd>
    </dl>

    <form asp-action="DeleteProgram" method="post">
        <input type="hidden" asp-for="Id" />
        <a asp-action="Programs" class="btn btn-secondary me-2">Back</a>
        <button type="submit" class="btn btn-danger" @(hasRelations ? "disabled" : "")>Delete</button>
    </form>
</div>

