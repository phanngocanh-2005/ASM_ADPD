@model AuthApp.Models.Schedule
@using Microsoft.AspNetCore.Mvc.Rendering
@using System.Linq

@{
    var timeSlots = ViewBag.TimeSlotOptions as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

@{
    ViewData["Title"] = "Edit Schedule";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="fas fa-edit"></i> Edit Schedule
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CourseId" class="form-label">Course <span class="text-danger">*</span></label>
                        <select asp-for="CourseId" class="form-select" asp-items="ViewBag.Courses">
                            <option value="">-- Select Course --</option>
                        </select>
                        <span asp-validation-for="CourseId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="TeacherId" class="form-label">Teacher <span class="text-danger">*</span></label>
                        <select asp-for="TeacherId" class="form-select" asp-items="ViewBag.Teachers">
                            <option value="">-- Select Teacher --</option>
                        </select>
                        <span asp-validation-for="TeacherId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold">Enroll Students to Course</label>
                        <div class="input-group mb-2">
                            <input type="text" id="studentCodeInput" class="form-control" placeholder="Enter student code (e.g., SV001)" />
                            <button type="button" class="btn btn-primary" id="addStudentBtn">
                                <i class="fas fa-plus"></i> Add Student
                            </button>
                        </div>
                        <small class="form-text text-muted">
                            Enter student codes to automatically enroll them in this course. You can add multiple students.
                        </small>
                        <div id="studentList" class="mt-3"></div>
                        <input type="hidden" name="StudentCodes" id="studentCodesInput" />
                    </div>
                </div>

                @{
                    var enrolledStudents = ViewBag.EnrolledStudents as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
                }
                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold">
                            Currently Enrolled Students 
                            @if (enrolledStudents.Any())
                            {
                                <span class="badge bg-info">@enrolledStudents.Count()</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">0</span>
                            }
                        </label>
                        @if (enrolledStudents.Any())
                        {
                            <div class="card">
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>#</th>
                                                    <th>Student Code</th>
                                                    <th>Student Name</th>
                                                    <th>Actions</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @{
                                                    int index = 1;
                                                }
                                                @foreach (var student in enrolledStudents)
                                                {
                                                    <tr id="enrolled-student-@student.EnrollmentId">
                                                        <td>@index</td>
                                                        <td><strong class="text-primary">@student.Code</strong></td>
                                                        <td>@student.Name</td>
                                                        <td>
                                                            <button type="button" class="btn btn-sm btn-danger" onclick="removeEnrolledStudent(@student.EnrollmentId, @Model.Id, '@Html.Raw(student.Code)')">
                                                                <i class="fas fa-trash"></i> Remove
                                                            </button>
                                                        </td>
                                                    </tr>
                                                    index++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i> No students enrolled in this course yet.
                            </div>
                        }
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DayOfWeek" class="form-label">Day of Week <span class="text-danger">*</span></label>
                        <select asp-for="DayOfWeek" class="form-select" asp-items="ViewBag.DayOfWeekOptions">
                            <option value="">-- Select Day --</option>
                        </select>
                        <span asp-validation-for="DayOfWeek" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Time Slot</label>
                        <select id="timeSlotSelect" class="form-select">
                            <option value="">-- Select Time Slot --</option>
                            @foreach (var slot in timeSlots)
                            {
                                <option value="@slot.Value">@slot.Text</option>
                            }
                        </select>
                        <small class="form-text text-muted">Selecting a slot will autofill the times.</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="StartTime" class="form-label">Start Time <span class="text-danger">*</span></label>
                        <input asp-for="StartTime" type="time" class="form-control" />
                        <span asp-validation-for="StartTime" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="EndTime" class="form-label">End Time <span class="text-danger">*</span></label>
                        <input asp-for="EndTime" type="time" class="form-control" />
                        <span asp-validation-for="EndTime" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Room" class="form-label">Room</label>
                        <input asp-for="Room" class="form-control" placeholder="e.g., A101" />
                        <span asp-validation-for="Room" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Building" class="form-label">Building</label>
                        <input asp-for="Building" class="form-control" placeholder="e.g., Main Building" />
                        <span asp-validation-for="Building" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ClassType" class="form-label">Class Type</label>
                        <select asp-for="ClassType" class="form-select" asp-items="ViewBag.ClassTypeOptions">
                            <option value="">-- Select Type --</option>
                        </select>
                        <span asp-validation-for="ClassType" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label">Status <span class="text-danger">*</span></label>
                        <select asp-for="Status" class="form-select" asp-items="ViewBag.StatusOptions"></select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Update Schedule
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const editTimeSlotSelect = document.getElementById('timeSlotSelect');
        const editStartInput = document.getElementById('StartTime');
        const editEndInput = document.getElementById('EndTime');

        if (editTimeSlotSelect && editStartInput && editEndInput) {
            editTimeSlotSelect.addEventListener('change', function () {
                const selectedSlot = this.value;
                if (!selectedSlot) {
                    return;
                }
                const times = selectedSlot.split('-');
                if (times.length === 2) {
                    editStartInput.value = times[0].trim();
                    editEndInput.value = times[1].trim();
                }
            });

            function syncSlotSelection() {
                const slotValue = (editStartInput.value?.substring(0, 5) ?? '') + '-' + (editEndInput.value?.substring(0, 5) ?? '');
                const option = Array.from(editTimeSlotSelect.options).find(opt => opt.value === slotValue);
                editTimeSlotSelect.value = option ? slotValue : '';
            }

            editStartInput.addEventListener('change', syncSlotSelection);
            editEndInput.addEventListener('change', syncSlotSelection);
            syncSlotSelection();
        }

        // Student enrollment functionality
        var enrolledStudents = [];
        var studentCodeInput = document.getElementById('studentCodeInput');
        var addStudentBtn = document.getElementById('addStudentBtn');
        var studentList = document.getElementById('studentList');
        var studentCodesInput = document.getElementById('studentCodesInput');

        // Search student when typing
        var searchTimeout;
        studentCodeInput.addEventListener('input', function() {
            clearTimeout(searchTimeout);
            var code = this.value.trim();
            
            if (code.length >= 2) {
                searchTimeout = setTimeout(function() {
                    searchStudent(code);
                }, 300);
            } else {
                hideStudentInfo();
            }
        });

        // Add student when button clicked or Enter pressed
        addStudentBtn.addEventListener('click', addStudent);
        studentCodeInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                addStudent();
            }
        });

        function searchStudent(code) {
            fetch('@Url.Action("SearchStudentByCode", "Schedule")?studentCode=' + encodeURIComponent(code))
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showStudentInfo(data.student);
                    } else {
                        hideStudentInfo();
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    hideStudentInfo();
                });
        }

        function showStudentInfo(student) {
            var infoDiv = document.getElementById('studentInfo');
            if (!infoDiv) {
                infoDiv = document.createElement('div');
                infoDiv.id = 'studentInfo';
                infoDiv.className = 'alert alert-info mt-2';
                studentCodeInput.parentElement.parentElement.appendChild(infoDiv);
            }
            infoDiv.innerHTML = '<i class="fas fa-user"></i> <strong>' + student.name + '</strong> (' + student.code + ')';
        }

        function hideStudentInfo() {
            var infoDiv = document.getElementById('studentInfo');
            if (infoDiv) {
                infoDiv.remove();
            }
        }

        function addStudent() {
            var code = studentCodeInput.value.trim();
            if (!code) {
                alert('Please enter a student code');
                return;
            }

            // Check if already added
            if (enrolledStudents.some(s => s.code.toLowerCase() === code.toLowerCase())) {
                alert('This student is already added');
                return;
            }

            // Search for student
            fetch('@Url.Action("SearchStudentByCode", "Schedule")?studentCode=' + encodeURIComponent(code))
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        enrolledStudents.push(data.student);
                        updateStudentList();
                        studentCodeInput.value = '';
                        hideStudentInfo();
                    } else {
                        alert('Student not found: ' + code);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error searching for student');
                });
        }

        function removeStudent(code) {
            enrolledStudents = enrolledStudents.filter(s => s.code !== code);
            updateStudentList();
        }

        function updateStudentList() {
            if (enrolledStudents.length === 0) {
                studentList.innerHTML = '';
                studentCodesInput.value = '';
                return;
            }

            var html = '<div class="card"><div class="card-body"><h6 class="card-title">Enrolled Students (' + enrolledStudents.length + ')</h6><div class="d-flex flex-wrap gap-2">';
            enrolledStudents.forEach(function(student, index) {
                html += '<span class="badge bg-primary p-2 d-flex align-items-center gap-2" id="student-badge-' + index + '">' +
                    '<span>' + student.name + ' (' + student.code + ')</span>' +
                    '<button type="button" class="btn-close btn-close-white" data-code="' + student.code + '" aria-label="Remove"></button>' +
                    '</span>';
            });
            html += '</div></div></div>';
            studentList.innerHTML = html;

            // Attach event listeners to remove buttons
            studentList.querySelectorAll('.btn-close').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var code = this.getAttribute('data-code');
                    removeStudent(code);
                });
            });

            // Update hidden input
            studentCodesInput.value = enrolledStudents.map(s => s.code).join(',');
        }

        // Xóa sinh viên đã enroll
        function removeEnrolledStudent(enrollmentId, scheduleId, studentCode) {
            if (!confirm('Are you sure you want to remove student ' + studentCode + ' from this course?')) {
                return;
            }

            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var tokenValue = token ? token.value : '';

            var formData = new FormData();
            formData.append('enrollmentId', enrollmentId);
            formData.append('scheduleId', scheduleId);
            formData.append('__RequestVerificationToken', tokenValue);

            fetch('@Url.Action("RemoveStudentFromCourse", "Schedule")', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Xóa dòng khỏi bảng
                    var row = document.getElementById('enrolled-student-' + enrollmentId);
                    if (row) {
                        row.remove();
                    }
                    
                    // Hiển thị thông báo thành công
                    alert('Student removed successfully');
                    
                    // Reload trang để cập nhật số lượng
                    location.reload();
                } else {
                    alert('Error: ' + data.message);
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('An error occurred while removing the student');
            });
        }
    </script>
}

