@model IEnumerable<AuthApp.Models.Schedule>

@{
    ViewData["Title"] = "Schedule Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="fas fa-calendar-alt"></i> Schedule Management
        </h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Create New Schedule
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>Course</th>
                                <th>Teacher</th>
                                <th>Day of Week</th>
                                <th>Time</th>
                                <th>Room</th>
                                <th>Building</th>
                                <th>Class Type</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@schedule.Course?.CourseCode</strong>
                                        <br />
                                        <small class="text-muted">@schedule.Course?.CourseName</small>
                                    </td>
                                    <td>
                                        <strong>@schedule.Teacher?.FullName</strong>
                                        <br />
                                        <small class="text-muted">@schedule.Teacher?.TeacherCode</small>
                                    </td>
                                    <td>@schedule.DayOfWeek</td>
                                    <td>
                                        @schedule.StartTime.ToString(@"hh\:mm") - @schedule.EndTime.ToString(@"hh\:mm")
                                    </td>
                                    <td>@(schedule.Room ?? "-")</td>
                                    <td>@(schedule.Building ?? "-")</td>
                                    <td>@(schedule.ClassType ?? "-")</td>
                                    <td>
                                        <span class="badge @(schedule.Status == "Active" ? "bg-success" : "bg-secondary")">
                                            @schedule.Status
                                        </span>
                                    </td>
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@schedule.Id" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@schedule.Id" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No schedules found. Create a new schedule to get started.
        </div>
    }
</div>

