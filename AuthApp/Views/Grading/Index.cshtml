@model List<AuthApp.Models.Course>

@{
    ViewData["Title"] = "Grade Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary">
            <i class="fas fa-graduation-cap"></i> Grade Management
        </h2>
        <a asp-controller="TeacherHome" asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-book-open"></i> Courses You Are Teaching</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Course Code</th>
                                <th>Course Name</th>
                                <th>Credits</th>
                                <th>Semester</th>
                                <th>Academic Year</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var course in Model)
                            {
                                <tr>
                                    <td><strong class="text-primary">@course.CourseCode</strong></td>
                                    <td>@course.CourseName</td>
                                    <td>
                                        <span class="badge bg-info">@course.Credits</span>
                                    </td>
                                    <td>@(course.Semester?.ToString() ?? "N/A")</td>
                                    <td>@(course.AcademicYear ?? "N/A")</td>
                                    <td class="text-center">
                                        <a asp-action="GradeStudents" asp-route-courseId="@course.Id" class="btn btn-sm btn-primary">
                                            <i class="fas fa-edit"></i> Manage Grades
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    <i class="fas fa-info-circle"></i> You are not currently assigned to teach any courses.
                </div>
            }
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-3 mt-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-primary">
                    <div class="card-body text-center">
                        <h3 class="text-primary mb-0">@Model.Count</h3>
                        <small class="text-muted">Total Courses</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-success">
                    <div class="card-body text-center">
                        <h3 class="text-success mb-0">@Model.Sum(c => c.Credits)</h3>
                        <small class="text-muted">Total Credits</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-info">
                    <div class="card-body text-center">
                        <h3 class="text-info mb-0">@Model.Select(c => c.AcademicYear).Distinct().Count()</h3>
                        <small class="text-muted">Academic Years</small>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
