@{
    ViewData["Title"] = "Teacher Home";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-primary mb-4">
                <i class="fas fa-chalkboard-teacher"></i> Teacher Dashboard
            </h2>
        </div>
    </div>

    <div class="row g-4">
        <!-- Teacher Profile Card -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-primary" style="transition: transform 0.2s; cursor: pointer;" 
                 onmouseover="this.style.transform='scale(1.05)'"
                 onmouseout="this.style.transform='scale(1)'">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="fas fa-user-circle fa-4x text-primary"></i>
                    </div>
                    <h4 class="card-title text-primary mb-3">Teacher Profile</h4>
                    <p class="card-text text-muted">
                        View and manage your personal information and profile details.
                    </p>
                    <a asp-controller="TeacherHome" asp-action="Profile" class="btn btn-primary mt-3">
                        <i class="fas fa-arrow-right"></i> View Profile
                    </a>
                </div>
            </div>
        </div>

        <!-- Schedule Card -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-success" style="transition: transform 0.2s; cursor: pointer;"
                 onmouseover="this.style.transform='scale(1.05)'"
                 onmouseout="this.style.transform='scale(1)'">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="fas fa-calendar-alt fa-4x text-success"></i>
                    </div>
                    <h4 class="card-title text-success mb-3">Schedule</h4>
                    <p class="card-text text-muted">
                        View your weekly teaching schedule with class times and room assignments.
                    </p>
                    <a asp-controller="TeacherHome" asp-action="Schedule" class="btn btn-success mt-3">
                        <i class="fas fa-arrow-right"></i> View Schedule
                    </a>
                </div>
            </div>
        </div>

        <!-- Grade Management Card -->
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-warning" style="transition: transform 0.2s; cursor: pointer;"
                 onmouseover="this.style.transform='scale(1.05)'"
                 onmouseout="this.style.transform='scale(1)'">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <i class="fas fa-graduation-cap fa-4x text-warning"></i>
                    </div>
                    <h4 class="card-title text-warning mb-3">Grade Management</h4>
                    <p class="card-text text-muted">
                        Manage student grades by course and assignment type. Add, edit, or delete grades.
                    </p>
                    <a asp-controller="Grading" asp-action="Index" class="btn btn-warning mt-3">
                        <i class="fas fa-arrow-right"></i> Manage Grades
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
