@{
}

<style>
    :root {
        --btec-orange: #FF6600;
        --btec-orange-dark: #e65500;
    }

    body, html {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    .bg-full {
        background-image: url('/Figure/background.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-box {
        background: rgba(255, 255, 255, 0.95);
        padding: 30px;
        border-radius: 15px;
        width: 100%;
        max-width: 400px;
        box-shadow: 0px 4px 15px rgba(0,0,0,0.25);
        animation: fadeIn 0.5s ease-in-out;
    }

    .btec-logo {
        width: 150px;
        display: block;
        margin: 0 auto 20px auto;
    }

    label {
        color: var(--btec-orange);
        font-weight: bold;
    }

    .form-control {
        border: 2px solid var(--btec-orange);
        border-radius: 8px;
    }

        .form-control:focus {
            border-color: var(--btec-orange-dark);
            box-shadow: 0 0 6px rgba(255,102,0,0.5);
        }

    .btn-btec {
        background: var(--btec-orange);
        border: none;
        color: white;
        font-weight: bold;
        border-radius: 8px;
        padding: 10px;
        width: 100%;
        transition: 0.25s;
    }

        .btn-btec:hover {
            background: var(--btec-orange-dark);
            transform: translateY(-2px);
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>


<div class="bg-full">
    <div class="login-box">

        <!-- Logo BTEC đúng đường dẫn -->
        <img src="/Figure/Btec.png" class="btec-logo" alt="BTEC Logo" />

        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label>Username</label>
                <input type="text" name="username" class="form-control" required />
            </div>

            <div class="mb-3">
                <label>Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>

            <div class="mb-3">
                <label>Role</label>
                <select name="role" class="form-control" required>
                    <option value="">Select Role</option>
                    <option value="Admin">Admin</option>
                    <option value="Teacher">Teacher</option>
                    <option value="Student">Student</option>
                </select>
            </div>

            <button type="submit" class="btn-btec">
                Login
            </button>
        </form>

    </div>
</div>