@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Teacher Login - AuthApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body>
<style>
    :root {
        --btec-orange: #FF6600;
        --btec-orange-dark: #e65500;
    }

    body, html {
        height: 100%;
        margin: 0;
        padding: 0;
    }

    .bg-full {
        background-image: url('/Figure/background.png');
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-box {
        background: rgba(255, 255, 255, 0.95);
        padding: 30px;
        border-radius: 15px;
        width: 100%;
        max-width: 400px;
        box-shadow: 0px 4px 15px rgba(0,0,0,0.25);
        animation: fadeIn 0.5s ease-in-out;
    }

    .btec-logo {
        width: 150px;
        display: block;
        margin: 0 auto 20px auto;
    }

    label {
        color: var(--btec-orange);
        font-weight: bold;
    }

    .form-control {
        border: 2px solid var(--btec-orange);
        border-radius: 8px;
    }

    .form-control:focus {
        border-color: var(--btec-orange-dark);
        box-shadow: 0 0 6px rgba(255,102,0,0.5);
    }

    .btn-btec {
        background: var(--btec-orange);
        border: none;
        color: white;
        font-weight: bold;
        border-radius: 8px;
        padding: 12px;
        width: 100%;
        transition: 0.25s;
    }

    .btn-btec:hover {
        background: var(--btec-orange-dark);
        transform: translateY(-2px);
    }

    .form-check-input:checked {
        background-color: var(--btec-orange);
        border-color: var(--btec-orange);
    }

    .login-header {
        text-align: center;
        margin-bottom: 25px;
    }

    .login-header h2 {
        color: var(--btec-orange);
        font-weight: bold;
    }

    .forgot-password {
        color: var(--btec-orange);
        text-decoration: none;
        font-size: 0.9em;
    }

    .forgot-password:hover {
        text-decoration: underline;
        color: var(--btec-orange-dark);
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(15px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .login-footer {
        margin-top: 20px;
        text-align: center;
        font-size: 0.9em;
    }

    .login-footer a {
        color: var(--btec-orange);
        text-decoration: none;
        font-weight: bold;
    }

    .login-footer a:hover {
        text-decoration: underline;
    }
</style>

<div class="bg-full">
    <div class="login-box">
        <div class="login-header">
            <img src="~/Figure/Btec.png" alt="BTEC Logo" class="btec-logo">
            <h2>ĐĂNG NHẬP GIÁO VIÊN</h2>
            <p class="text-muted">Vui lòng nhập thông tin đăng nhập của bạn</p>
        </div>

        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger" role="alert">
                <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
            </div>
        }

        <form method="post" asp-action="Login">
            <input type="hidden" name="role" value="Teacher" />
            
            <div class="mb-3">
                <label for="username" class="form-label">Tên đăng nhập</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-user"></i></span>
                    <input type="text" class="form-control" id="username" name="username" required 
                           value="@ViewBag.Username" placeholder="Nhập tên đăng nhập">
                </div>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between">
                    <label for="password" class="form-label">Mật khẩu</label>
                    <a href="#" class="forgot-password">Quên mật khẩu?</a>
                </div>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-lock"></i></span>
                    <input type="password" class="form-control" id="password" name="password" required 
                           placeholder="Nhập mật khẩu">
                </div>
            </div>

            <div class="mb-3 form-check">
                <input type="checkbox" class="form-check-input" id="rememberMe">
                <label class="form-check-label" for="rememberMe">Ghi nhớ đăng nhập</label>
            </div>

            <button type="submit" class="btn btn-btec mb-3">
                <i class="fas fa-sign-in-alt"></i> ĐĂNG NHẬP
            </button>

            <div class="login-footer">
                <p>Bạn chưa có tài khoản? <a href="#">Liên hệ quản trị viên</a></p>
                <p>hoặc <a href="/Login">quay lại trang đăng nhập chính</a></p>
            </div>
        </form>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
