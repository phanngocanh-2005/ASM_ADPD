@model AuthApp.Models.CourseAssignment

@{
    ViewData["Title"] = "Delete Course Assignment";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-danger">
            <i class="fas fa-trash"></i> @ViewData["Title"]
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i>
        Are you sure you want to delete this course assignment? This action cannot be undone.
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Teacher:</dt>
                <dd class="col-sm-9">
                    <strong>@Model.Teacher?.FullName</strong>
                    <span class="text-muted">(@Model.Teacher?.TeacherCode)</span>
                </dd>

                <dt class="col-sm-3">Course:</dt>
                <dd class="col-sm-9">
                    <strong>@Model.Course?.CourseCode</strong> - @Model.Course?.CourseName
                </dd>

                <dt class="col-sm-3">Assignment Date:</dt>
                <dd class="col-sm-9">
                    @Model.AssignmentDate.ToString("dd/MM/yyyy")
                </dd>

                <dt class="col-sm-3">Status:</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.Status == "Active" ? "bg-success" : Model.Status == "Completed" ? "bg-primary" : "bg-secondary")">
                        @Model.Status
                    </span>
                </dd>
            </dl>

            <form asp-action="Delete" method="post" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Delete
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>


