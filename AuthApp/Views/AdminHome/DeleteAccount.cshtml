@model AuthApp.Models.Account

@{
    ViewData["Title"] = "Confirm Account Deletion";                       
}

<div class="container mt-5">
    <h2 class="mb-4 text-danger">Confirm Account Deletion</h2>
    <hr />

    <div class="alert alert-danger" role="alert">
        <strong>WARNING:</strong> This action cannot be undone. Are you sure you want to delete this account?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Username:</dt>
        <dd class="col-sm-9">@Model.Username</dd>

        <dt class="col-sm-3">Full name:</dt>
        <dd class="col-sm-9">@Model.Fullname</dd>

        <dt class="col-sm-3">Role:</dt>
        <dd class="col-sm-9"><span class="badge bg-danger">@Model.Role</span></dd>

        <dt class="col-sm-3">Email:</dt>
        <dd class="col-sm-9">@Model.Email</dd>
    </dl>

    <form asp-action="DeleteAccount" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger me-2">
            <i class="fas fa-trash-alt"></i> Delete account
        </button>
        <a asp-action="ListAccounts" class="btn btn-secondary">Cancel</a>
    </form>
</div>