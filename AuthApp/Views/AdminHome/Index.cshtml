@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-5">
    <h1 class="text-center text-danger mb-4">
        <i class="fas fa-tools"></i> System Administration Dashboard
    </h1>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="border rounded-3 p-3 bg-light">
                <h5 class="fw-semibold text-secondary">Overview</h5>
                <ul class="list-unstyled mb-0">
                    <li><strong>Admins:</strong> @ViewBag.AdminCount</li>
                    <li><strong>Teachers:</strong> @ViewBag.TeacherCount</li>
                    <li><strong>Students:</strong> @ViewBag.StudentCount</li>
                    <li><strong>Programs:</strong> @ViewBag.ProgramCount</li>
                </ul>
            </div>
        </div>
        <div class="col-md-6">
            <div class="border rounded-3 p-3 bg-light">
                <h5 class="fw-semibold text-secondary">Student Profiles</h5>
                <p class="display-6 mb-1">@ViewBag.StudentProfiles</p>
                <small class="text-muted">Detailed student records in the system</small>
            </div>
        </div>
    </div>
</div>